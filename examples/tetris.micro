ator Peca
  desenho texto 1, "████", ciano
  posição 18, 3
  velocidade 0, 0.3
  quando atualiza:
    se tecla("esquerda") ou tecla("a") então
      se x > 11 então
        x recebe x - 1
      fim
    fim
    se tecla("direita") ou tecla("d") então
      se x < 23 então
        x recebe x + 1
      fim
    fim
    se tecla("baixo") ou tecla("s") então
      y recebe y + 0.4
    fim
    se y >= 24 então
      pontos recebe pontos + 10
      diga "Encaixado! Pontos: " + pontos
      y recebe 3
      x recebe aleatorio(12, 22)
    fim
  fim
  quando colide com "BlocoCaido1":
    pontos recebe pontos + 15
    y recebe 3
    x recebe aleatorio(12, 22)
  fim
  quando colide com "BlocoCaido2":
    pontos recebe pontos + 15
    y recebe 3
    x recebe aleatorio(12, 22)
  fim
fim
