tela 40x30
fundo preto

# Geometric Run - ASCII Terminal Runner
# Pressione ESPAÇO, SETA CIMA ou W para pular os obstáculos!

pontos recebe 0
pulando recebe 0
vy recebe 0

ator Chao
  desenho texto 1, "════════════════════════════════════════", cinza
  posição 0, 24
fim

ator Jogador
  desenho texto 1, "🏃", amarelo
  posição 6, 22
  quando atualiza:
    # Gravidade física do salto
    vy recebe vy + 0.1
    y recebe y + vy

    # Apoio no chão (y = 22)
    se y >= 22 então
      y recebe 22
      vy recebe 0
      pulando recebe 0
    fim

    # Salto com Espaço, W ou Seta para Cima
    se pulando == 0 então
      se tecla("espaco") ou tecla("arrowup") ou tecla("w") ou tecla("cima") então
        vy recebe -1.2
        pulando recebe 1
        diga "Pulo!"
      fim
    fim
  fim
fim

ator Obstaculo
  desenho texto 1, "▲", vermelho
  posição 40, 23
  velocidade -0.5, 0
  quando atualiza:
    se x < -5 então
      x recebe 40 + aleatorio(5, 20)
      pontos recebe pontos + 1
      diga "Obstáculo superado! Pontos: " + pontos
    fim
  fim
  quando colide com "Jogador":
    diga "💥 GAME OVER! Pontuação final: " + pontos
    pontos recebe 0
    x recebe 40
  fim
fim

ator EstrelaNeon
  desenho texto 1, "·", branco
  posição 35, 8
  velocidade -0.15, 0
  quando atualiza:
    se x < -5 então
      x recebe 40
      y recebe aleatorio(4, 15)
    fim
  fim
fim
