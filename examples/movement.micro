tela 40x25
fundo preto

ator Jogador
  desenho texto 1, "😎", verde
  posição 18, 12
  quando atualiza:
    se tecla("direita") ou tecla("d") então
      se x < 38 então
        x recebe x + 0.5
      fim
    fim
    se tecla("esquerda") ou tecla("a") então
      se x > 0 então
        x recebe x - 0.5
      fim
    fim
    se tecla("cima") ou tecla("w") então
      se y > 0 então
        y recebe y - 0.5
      fim
    fim
    se tecla("baixo") ou tecla("s") então
      se y < 24 então
        y recebe y + 0.5
      fim
    fim
  fim
fim
