tela 40x30
fundo preto

pontos1 recebe 0
pontos2 recebe 0

ator Jogador1
  desenho texto 1, "█\n█\n█\n█", azul
  posição 2, 13
  quando atualiza:
    se tecla("w") ou tecla("arrowup") então
      se y > 0 então
        y recebe y - 0.5
      fim
    fim
    se tecla("s") ou tecla("arrowdown") então
      se y < 26 então
        y recebe y + 0.5
      fim
    fim
  fim
fim

ator Jogador2
  desenho texto 1, "█\n█\n█\n█", verde
  posição 37, 13
  quando atualiza:
    se Bola.y > y + 1 então
      se y < 26 então
        y recebe y + 0.4
      fim
    senão se Bola.y < y + 1 então
      se y > 0 então
        y recebe y - 0.4
      fim
    fim
  fim
fim

ator Bola
  desenho texto 1, "●", branco
  posição 20, 15
  velocidade 0.5, 0.3
  quica nas bordas verticais
  quando atualiza:
    se x < 0 então
      pontos2 recebe pontos2 + 1
      x recebe 20
      y recebe 15
      vx recebe 0.5
      diga "Ponto Jogador 2!"
    senão se x > 40 então
      pontos1 recebe pontos1 + 1
      x recebe 20
      y recebe 15
      vx recebe -0.5
      diga "Ponto Jogador 1!"
    fim
  fim
  quando colide com "Jogador1":
    vx recebe 0.55
  fim
  quando colide com "Jogador2":
    vx recebe -0.55
  fim
fim
